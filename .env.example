# Copie para .env na VPS e preencha. O .env NÃO vai pro git.

DB_NAME=tramposeditor
DB_USERNAME=tramposeditor
DB_PASSWORD=troque-por-uma-senha-forte

# Mínimo 32 caracteres (HS256). Gere com:  openssl rand -base64 48
JWT_SECRET=

# Tempo de vida do token, formato ISO-8601 (PT12H = 12 horas)
JWT_TTL=PT12H

# Origem do frontend em produção, separado por vírgula
CORS_ALLOWED_ORIGINS=https://tramposeditor.com.br

# Produção exige smtp. Em desenvolvimento, log simula envio (nunca use log em prod).
NOTIFICATIONS_TRANSPORT=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Endereço autorizado pelo provedor; configure SPF/DKIM no domínio com autorização.
NOTIFICATIONS_FROM=
# URL pública HTTPS do frontend, sem caminho ou barra final.
FRONTEND_BASE_URL=https://tramposeditor.com.br
