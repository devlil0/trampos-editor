# Veja docs/DEPLOY.md. Preencha a configuração privada fora do Git.

DB_NAME=tramposeditor
DB_USERNAME=tramposeditor
DB_PASSWORD=

# Mínimo de 32 bytes (HS256). Gere com: openssl rand -base64 48
JWT_SECRET=
JWT_TTL=PT12H

# Origens públicas HTTPS. SITE_URL e FRONTEND_BASE_URL apontam para o site.
SITE_URL=https://tramposeditor.com.br
FRONTEND_BASE_URL=https://tramposeditor.com.br
PUBLIC_API_URL=https://api.tramposeditor.com.br
CORS_ALLOWED_ORIGINS=https://tramposeditor.com.br

# Endereço da API na rede interna do Compose.
API_URL=http://app:8080
API_HOST_PORT=8080
FRONTEND_HOST_PORT=3000

# Arquivo opcional. Sem ele, o login social fica desativado.
OAUTH_ENV_FILE=.env.oauth

# Produção exige SMTP autenticado com STARTTLS.
NOTIFICATIONS_TRANSPORT=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Remetente autorizado pelo provedor SMTP.
NOTIFICATIONS_FROM=
