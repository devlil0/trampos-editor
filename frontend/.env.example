# URL do backend (Spring Boot). Lido apenas no servidor (SSR).
# Em produção, apontar pro host interno da API atrás do Nginx.
API_URL=http://localhost:8080

# URL pública do site. Usada nas URLs absolutas de metadata (og:image, canonical).
# Trocar pelo domínio real quando ele for registrado.
SITE_URL=http://localhost:3000
