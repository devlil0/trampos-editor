# URL interna do backend, usada pelo servidor Next.js (SSR).
# Em contêiner, use o endereço da API acessível pela rede do frontend.
API_URL=http://localhost:8080

# URL pública do backend, acessível pelo navegador para avatares e links OAuth.
PUBLIC_API_URL=http://localhost:8080

# URL pública do frontend, usada em metadata, robots.txt e sitemap.xml.
# Em produção, configure a origem HTTPS sem barra no final.
SITE_URL=http://localhost:3000
