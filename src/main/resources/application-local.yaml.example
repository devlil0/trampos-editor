# Credenciais locais — MODELO. Copie para `application-local.yaml` (sem `.example`) e
# preencha. O arquivo real está no .gitignore e nunca deve ser comitado.
#
# Pra subir com ele:
#   .\mvnw.cmd -o spring-boot:run -Dspring-boot.run.profiles=dev,local
#
# O perfil `local` vem DEPOIS de `dev` de propósito: o último da lista ganha, então o que
# estiver aqui sobrescreve o default. Sem `local` na lista, a aplicação sobe exatamente
# como antes — este arquivo é aditivo, não obrigatório.

spring:
  # ---------------------------------------------------------------------------------
  # Envio real de e-mail (Resend). OPCIONAL — e por padrão você NÃO quer isto ligado.
  #
  # Sem este bloco o transporte continua sendo `log`: o e-mail aparece no console e não
  # vai pra rede. É o certo pro dia a dia. Ligue aqui só quando quiser ver um envio de
  # verdade chegando numa caixa.
  #
  # A chave é a API key da Resend, e ela vai em `password`. Duas coisas que ela NÃO é:
  # não é a senha de nenhuma caixa de e-mail (não existe caixa — `nao-responda@` só
  # remete), e não é variável do frontend. Nunca a coloque no `application.yaml`, que é
  # versionado, nem no `.env.local` do Next, que é do outro lado.
  #
  # Confirme host, porta e usuário no painel da Resend (Domains → SMTP) em vez de
  # confiar neste comentário: são deles, podem mudar, e errar aqui dá falha de auth que
  # parece bug da aplicação.
  #
  # mail:
  #   host: smtp.resend.com
  #   port: 587
  #   username: resend
  #   password: COLE_AQUI_A_API_KEY
  #   properties:
  #     mail:
  #       smtp:
  #         auth: true
  #         starttls:
  #           enable: true

  security:
    oauth2:
      client:
        registration:
          # Console: https://console.cloud.google.com → APIs & Services → Credentials
          # Callback a cadastrar lá: http://localhost:8080/login/oauth2/code/google
          google:
            client-id: COLE_AQUI
            client-secret: COLE_AQUI

          # Console: GitHub → Settings → Developer settings → OAuth Apps
          # Callback a cadastrar lá: http://localhost:8080/login/oauth2/code/github
          github:
            client-id: COLE_AQUI
            client-secret: COLE_AQUI
            # Obrigatório: o escopo padrão do GitHub é só `read:user`, e sem `user:email`
            # quem tem e-mail privado chega aqui sem e-mail — e sem e-mail não dá pra
            # aplicar a conta única do FUNDACAO §11.9.
            scope: read:user,user:email

# Deixe fora deste arquivo o provedor que você ainda não criou: registro pela metade
# derruba a aplicação na subida com "Client id of registration 'x' must not be empty".
# Só Google configurado é um estado válido — o botão do GitHub simplesmente não aparece.

# Companheiro do bloco `spring.mail` lá em cima: sem isto, configurar SMTP não muda nada,
# porque quem escolhe o adaptador é esta chave. E o contrário também vale — ligar `smtp`
# SEM o bloco `spring.mail.host` derruba a subida, porque aí não existe JavaMailSender pro
# SmtpEmailSender receber. Os dois andam juntos ou nenhum dos dois.
#
# tramposeditor:
#   notifications:
#     transport: smtp
#     # O domínio do remetente tem que ser um domínio VERIFICADO na Resend. Enquanto a
#     # verificação não passa, ela só aceita enviar pro e-mail da sua própria conta.
#     from: TramposEditor <nao-responda@tramposeditor.com>
